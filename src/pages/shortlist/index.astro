---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('churches')).sort((a, b) => a.data.difficulty - b.data.difficulty);
const countries = [...new Set(all.map((c) => c.data.country))].sort();
const real = all.filter((c) => !c.data.specimen);
---

<Base title="The shortlist" description="Old churches for sale that we have read, checked and scored.">
  <div class="wrap">
    <header class="page-head">
      <h1>The shortlist</h1>
    </header>
    <div class="prose" style="padding-bottom: 2rem">
      {real.length === 0 && (
        <p class="empty">
          The first churches are being checked now. Until they are published, the specimen below
          shows what a profile contains.
        </p>
      )}
    </div>

    <form class="filters" aria-label="Filter the shortlist">
      <label>
        Country
        <select name="country">
          <option value="">All countries</option>
          {countries.map((c) => <option>{c}</option>)}
        </select>
      </label>
      <label>
        Difficulty
        <select name="difficulty">
          <option value="">Any</option>
          <option value="2">2 or easier</option>
          <option value="3">3 or easier</option>
          <option value="4">4 or easier</option>
        </select>
      </label>
      <span class="count" aria-live="polite"><span id="count">{all.length}</span> shown</span>
    </form>

    <div id="tiles" style="padding-bottom: 5rem">
      {countries.map((country) => (
        <section class="country" data-country={country}>
          <h2 class="country-head">{country} <span>{all.filter((c) => c.data.country === country).length}</span></h2>
          <ul class="tiles">
            {all.filter((c) => c.data.country === country).map((c) => (
              <li data-country={c.data.country} data-verdict={c.data.verdict} data-difficulty={c.data.difficulty}>
                <Tile church={c} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="empty" id="none" hidden>No church matches those filters. Loosen one.</p>
  </div>

  <script>
    const form = document.querySelector('.filters') as HTMLFormElement;
    const items = [...document.querySelectorAll<HTMLLIElement>('#tiles li[data-country]')];
    const groups = [...document.querySelectorAll<HTMLElement>('#tiles .country')];
    const count = document.getElementById('count')!;
    const none = document.getElementById('none')!;
    function apply() {
      const f = new FormData(form);
      const country = f.get('country'), max = Number(f.get('difficulty')) || 5;
      let shown = 0;
      for (const li of items) {
        const ok =
          (!country || li.dataset.country === country) &&
          Number(li.dataset.difficulty) <= max;
        li.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('li[data-country]:not([hidden])');
      count.textContent = String(shown);
      none.hidden = shown > 0;
    }
    form.addEventListener('change', apply);
  </script>
</Base>
