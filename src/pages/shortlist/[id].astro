---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { ageText } from '../../lib/age';
import sharp from 'sharp';

export async function getStaticPaths() {
  const ORDER = ['France', 'England', 'Scotland', 'Italy', 'Ireland', 'Portugal', 'Czech Republic', 'Wales'];
  const rank = (c: string) => (ORDER.indexOf(c) + 1) || 99;
  const all = (await getCollection('churches')).sort((a, b) => rank(a.data.country) - rank(b.data.country) || a.data.difficulty - b.data.difficulty);
  return all.map((church, i) => ({
    params: { id: church.id },
    props: { church, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length], ids: all.map((c) => c.id) },
  }));
}

const { church, prev, next, ids } = Astro.props;
const d = church.data;
const { Content } = await render(church);
const tall = await Promise.all(d.photos.map(async (p) => {
  try { const m = await sharp('public' + p.src).metadata(); return (m.height ?? 0) > (m.width ?? 0) * 1.05; } catch { return false; }
}));
const small = (src: string) => src.replace(/\/(\d+)\.jpg$/, '/t/$1.webp');
const age = ageText(d.built, d.builtNote, d.builtRound);
const checked = d.lastChecked.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });

const eur = (n: number) => d.currency + n.toLocaleString('en-GB');
const range = (lo: number, hi: number) => (hi === 0 ? 'Nothing' : lo === hi ? eur(lo) : `${eur(lo)} to ${eur(hi)}`);
const phases = ['Now', 'Next', 'Later'] as const;
const phaseText = { Now: 'Now: safe and dry', Next: 'Next: fabric and glass', Later: 'Later: interior and services' };
const basisText = { listing: 'From the listing', photos: 'Seen in the photographs', record: 'From a public record', assumed: 'Assumed' };
const sum = (ws: typeof d.works, k: 'low' | 'high') => ws.reduce((t, w) => t + (w[k] ?? 0), 0);
const nowWorks = d.works.filter((w) => w.phase === 'Now');
const laterWorks = d.works.filter((w) => w.phase !== 'Now');
const hasWorks = d.works.length > 0;
// every Creative Commons or public-domain photograph is credited, once per distinct credit
const ccCredits = [...new Set(d.photos.map((p) => p.credit).filter((c) => /CC BY|CC0|Creative Commons|public domain/i.test(c)))];
const marks = { listing: 'From the listing', checked: 'Checked', unknown: 'Unknown' };

// which fact tables go under which tab
const inTab = (titles: string[]) => d.sections.filter((s) => titles.includes(s.title));
const repairSections = inTab(['Condition']);
const ruleSections = inTab(['Heritage status', 'Sacred status']);
const practicalSections = d.sections.filter((s) => !['Condition', 'Heritage status', 'Sacred status'].includes(s.title));

const practicalTitle: Record<string, string> = { 'The dead': 'Churchyard and burials' };
const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'story', label: 'The story' },
  { id: 'repairs', label: 'Repairs and costs' },
  { id: 'rules', label: 'Rules and seller' },
  { id: 'practical', label: 'Practical' },
];
---

<Base title={d.name} description={d.summary}>
  <div class="wrap">
    <p class="crumbs"><a href="/shortlist/">The shortlist</a> / {d.country} / {d.name}</p>

    {d.specimen && (
      <p class="notice">
        This is a specimen. The church is invented, to show what a profile contains. It is not for
        sale because it does not exist.
      </p>
    )}

    <div class="gallery">
      <div class="lead" id="lead-frame" style={d.photos[0] ? `--img: url(${small(d.photos[0].src)})` : undefined}>
        {d.photos[0] ? (
          <><img id="lead-photo" src={d.photos[0].src} alt={d.photos[0].alt} /><img id="lead-photo-2" alt="" hidden /></>
        ) : (
          <div style="text-align:center">
            <span class="numeral" aria-hidden="true"></span>
            <p class="hint">Photographs to come</p>
          </div>
        )}
      </div>
      {d.photos.length > 1 && (
        <div class="strip">
          {d.photos.map((p, i) => (
            <button type="button" class:list={['thumb', tall[i] && 'tall']} style={`--img: url(${small(p.src)})`} data-src={p.src} data-small={small(p.src)} data-alt={p.alt} aria-label={`Show photograph ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
              <img src={small(p.src)} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
      {ccCredits.length > 0 && <p class="credit">{ccCredits.join('. ')}</p>}
      <dialog class="zoom" id="zoom"><img alt="" /></dialog>
    </div>

    <div class="lot">
      <div class="lot-body">
        {age && <p class="label" style="color: var(--ink-soft); margin-bottom: 0.6rem">{age}</p>}
        <h1>{d.name}</h1>
        <p class="where">{d.place}, {d.region}, {d.country}</p>
        <p class="standfirst">{d.summary}</p>

        <div class="tabs" role="tablist" aria-label="Sections of this profile">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              {t.label}
            </button>
          ))}
        </div>

        <section class="panel-tab" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview">
          <Content />
        </section>

        <section class="panel-tab" role="tabpanel" id="panel-story" aria-labelledby="tab-story">
          <h2>The story</h2>
          {d.story.length > 0 && (
            <ol class="story">
              {d.story.map((e) => (
                <li><span class="when">{e.when}</span><span>{e.what}</span></li>
              ))}
            </ol>
          )}
          {d.storyNote && <p class="story-note">{d.storyNote}</p>}
          {d.storySources.length > 0 && (
            <p class="key" style="margin-top: 1rem">
              Sources: {d.storySources.map((r, i) => (
                <>{i > 0 && '; '}<a href={r.url} rel="noopener">{r.title}</a></>
              ))}
            </p>
          )}
        </section>

        <section class="panel-tab" role="tabpanel" id="panel-repairs" aria-labelledby="tab-repairs">
          <h2>Repairs and costs</h2>
          {d.estimateNote && <p>{d.estimateNote}</p>}

          {hasWorks && [
            { key: 'safe', title: 'Safe and dry', note: 'The first work, to stop the building getting worse.', ws: nowWorks, lo: sum(nowWorks, 'low'), hi: sum(nowWorks, 'high') },
            { key: 'full', title: 'Full restoration', note: nowWorks.length ? 'Everything else on the list. The figure includes the safe and dry work.' : 'Everything on the list.', ws: laterWorks, lo: sum(d.works, 'low'), hi: sum(d.works, 'high') },
          ].filter((g) => g.ws.length > 0).map((g) => (
            <details class={`stage stage-${g.key}`}>
              <summary class="stage-head"><h3>{g.title}</h3><b>{range(g.lo, g.hi)}</b></summary>
              <p class="stage-note">{g.note}</p>
              <ul class="lines">
                {g.ws.map((w) => (
                  <li>
                    <span>{w.item}</span>
                    <b>{w.low === undefined ? 'Not costed' : range(w.low, w.high ?? w.low)}</b>
                    <small>{basisText[w.basis]}</small>
                  </li>
                ))}
              </ul>
            </details>
          ))}
          {d.upkeep && (
            <details class="stage stage-year">
              <summary class="stage-head"><h3>Annual maintenance</h3><b>{range(d.upkeep.low, d.upkeep.high)}</b></summary>
              <p class="stage-note">{d.upkeep.covers}</p>
            </details>
          )}

          {d.grantNote && <p class="after-stages"><b>Grants.</b> {d.grantNote}</p>}

          {repairSections.map((s) => (
            <details class="fold">
              <summary>{s.title}, as the listing describes it</summary>
              <ul class="facts">
                {s.items.map((i) => (
                  <li><b>{i.label}</b><span>{i.value}</span></li>
                ))}
              </ul>
            </details>
          ))}
          {d.seen.length > 0 && (
            <details class="fold">
              <summary>What the photographs show</summary>
              <ul>{d.seen.map((s) => <li>{s}</li>)}</ul>
            </details>
          )}

          <p class="how-link"><a class="button how" href="/how-repair-costs-are-estimated/">How repair costs are estimated</a></p>
        </section>

        <section class="panel-tab" role="tabpanel" id="panel-rules" aria-labelledby="tab-rules">
          <h2>Rules and seller</h2>
          <details class="stage c0">
            <summary class="stage-head"><h3>The seller</h3><b>{d.seller}</b></summary>
            <p class="stage-note">{d.moneyGoes}</p>
          </details>
          <details class="stage c1">
            <summary class="stage-head"><h3>What you may do with it</h3><b>{d.verdict}</b></summary>
            <p class="stage-note">{d.verdictReason}</p>
          </details>
          {ruleSections.map((s, k) => (
            <details class={`stage c${(k + 2) % 3}`}>
              <summary class="stage-head"><h3>{s.title}</h3>{s.title === 'Heritage status' && <b>{d.heritageClass}</b>}</summary>
              <ul class="plain">
                {s.items.map((i) => (
                  <li><b>{i.label}.</b> {i.value}{i.source && <> <a class="src" href={i.source} rel="noopener">Source</a></>}</li>
                ))}
              </ul>
            </details>
          ))}
        </section>

        <section class="panel-tab" role="tabpanel" id="panel-practical" aria-labelledby="tab-practical">
          <h2>Practical</h2>
          {practicalSections.map((s, k) => (
            <details class={`stage c${k % 3}`}>
              <summary class="stage-head"><h3>{practicalTitle[s.title] ?? s.title}</h3></summary>
              <ul class="plain">
                {s.items.map((i) => (
                  <li><b>{i.label}.</b> {i.value}{i.source && <> <a class="src" href={i.source} rel="noopener">Source</a></>}</li>
                ))}
              </ul>
            </details>
          ))}
          {d.nearby.length > 0 && (
            <details class={`stage c${practicalSections.length % 3}`}>
              <summary class="stage-head"><h3>Restored nearby</h3></summary>
              <ul class="plain">
                {d.nearby.map((n) => (
                  <li><b>{n.url ? <a href={n.url} rel="noopener">{n.name}</a> : n.name}.</b> {n.note}</li>
                ))}
              </ul>
            </details>
          )}
          {d.contacts.length > 0 && (
            <details class={`stage c${(practicalSections.length + 1) % 3}`}>
              <summary class="stage-head"><h3>People to call</h3></summary>
              <ul class="plain">
                {d.contacts.map((c) => (
                  <li><b>{c.role}.</b> {c.url ? <a href={c.url} rel="noopener">{c.name}</a> : c.name}</li>
                ))}
              </ul>
            </details>
          )}
        </section>

      </div>

      <aside class="panel" aria-label="Key facts">
        <dl>
          <div><dt>{d.status === 'saved' ? 'Sold at' : 'Asking price'}</dt><dd class="price">{d.price}</dd></div>
          {hasWorks && (
            <div><dt>Rough cost of works</dt><dd>{range(sum(d.works, 'low'), sum(d.works, 'high'))}</dd></div>
          )}
          {d.upkeep && <div><dt>Each year</dt><dd>{range(d.upkeep.low, d.upkeep.high)}</dd></div>}
          <div><dt>Heritage status</dt><dd>{d.heritageClass}</dd></div>
          <div><dt>What you may do</dt><dd>{d.verdict}</dd></div>
          <div>
            <dt>Difficulty</dt>
            <dd>
              <span class="pips" aria-label={`${d.difficulty} of 5`}>
                {[1, 2, 3, 4, 5].map((n) => <svg class={n <= d.difficulty ? '' : 'off'} viewBox="0 0 20 24" aria-hidden="true"><path d="M9 0h2v2h2v2h-2v2l5 5v13h-4v-5a2 2 0 0 0-4 0v5H4V11l5-5V4H7V2h2z" /></svg>)}
              </span>
            </dd>
          </div>
        </dl>
        {d.listingUrl ? (
          <a class="button pop" href={d.listingUrl} rel="noopener">Save me! View the listing</a>
        ) : (
          <span class="button ghost" aria-disabled="true">Listing link to come</span>
        )}
      </aside>
    </div>
  </div>


  <script>
    const rr = document.getElementById('ring-random');
    if (rr) {
      const ids = (rr.dataset.ids || '').split(',').filter((x) => !location.pathname.includes(x));
      const base = rr.getAttribute('href');
      if (ids.length) rr.setAttribute('href', base + ids[Math.floor(Math.random() * ids.length)] + '/');
    }
  </script>
  <script>
    // Tabs: one panel at a time, without leaving the page. With no JavaScript every panel shows.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    function select(id: string, focus = false) {
      for (const t of tabs) {
        const on = t.id === `tab-${id}`;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      }
      for (const p of panels) p.hidden = p.id !== `panel-${id}`;
    }
    const fromHash = () => {
      const id = location.hash.slice(1);
      return tabs.some((t) => t.id === `tab-${id}`) ? id : 'overview';
    };
    document.documentElement.classList.add('tabs-on');
    select(fromHash());
    tabs.forEach((t, i) => {
      const id = t.id.replace('tab-', '');
      t.addEventListener('click', () => {
        select(id);
        history.replaceState(null, '', `#${id}`);
      });
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length].id.replace('tab-', '');
        select(next, true);
        history.replaceState(null, '', `#${next}`);
      });
    });
    window.addEventListener('hashchange', () => select(fromHash()));

    // Gallery: click a small photo to show it large. Upright photos show two abreast.
    const frame = document.getElementById('lead-frame');
    const lead = document.getElementById('lead-photo') as HTMLImageElement | null;
    const lead2 = document.getElementById('lead-photo-2') as HTMLImageElement | null;
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
    const isTall = (b: HTMLButtonElement) => b.classList.contains('tall');
    function show(b: HTMLButtonElement) {
      if (!lead || !lead2 || !frame) return;
      let mate: HTMLButtonElement | undefined;
      if (isTall(b)) {
        const i = thumbs.indexOf(b);
        const after = thumbs.slice(i + 1).find(isTall);
        const before = thumbs.slice(0, i).reverse().find(isTall);
        mate = after ?? before;
      }
      const pair = mate ? (thumbs.indexOf(mate) < thumbs.indexOf(b) ? [mate, b] : [b, mate]) : [b];
      lead.src = pair[0].dataset.src!;
      lead.alt = pair[0].dataset.alt!;
      lead2.hidden = pair.length < 2;
      if (pair[1]) { lead2.src = pair[1].dataset.src!; lead2.alt = pair[1].dataset.alt!; }
      frame.classList.toggle('pair', pair.length === 2);
      frame.classList.toggle('upright', isTall(b) && pair.length === 1);
      frame.style.setProperty('--img', `url(${b.dataset.small})`);
      thumbs.forEach((x) => x.setAttribute('aria-pressed', String(pair.includes(x))));
    }
    thumbs.forEach((b) => b.addEventListener('click', () => show(b)));
    if (thumbs[0] && isTall(thumbs[0])) show(thumbs[0]);
    const zoom = document.getElementById('zoom') as HTMLDialogElement | null;
    if (zoom) {
      for (const im of [lead, lead2]) {
        im?.addEventListener('click', () => {
          const big = zoom.querySelector('img')!;
          big.src = im.src;
          big.alt = im.alt;
          zoom.showModal();
        });
      }
      zoom.addEventListener('click', () => zoom.close());
    }
  </script>
</Base>
