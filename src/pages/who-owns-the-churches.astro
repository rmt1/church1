---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('churches')).filter((c) => !c.data.specimen && c.data.status !== 'saved');
const count = (country: string) => all.filter((c) => c.data.country === country).length;

const countries = [
  {
    name: 'France',
    stamp: '1789',
    under: 'Revolution',
    sells: 'Families and villages',
    money: 'The family, or the village budget',
    text: [
      'The French State took the Churches from the Church in 1789. The National Assembly declared all Church property the property of the nation, to pay off the debts of the State. The abbeys, convents and chapels were auctioned, and have been in private hands ever since. The parish Churches were kept open for worship.',
      'In 1905 the Republic separated Church and State and stopped paying for any religion. The parish Churches stayed public property. About 40,000 of them now belong to their village, and the State owns the 87 cathedrals.',
      'When a French Church comes up for sale, the seller is usually a family, or a village that can no longer afford it. The money goes to that family, or into the village budget.',
    ],
  },
  {
    name: 'England',
    stamp: '1536',
    under: 'Henry VIII',
    sells: 'The Church Commissioners, or a private owner selling on',
    money: 'Two thirds to the Churches still in use, one third to the care of closed Churches',
    text: [
      'Henry VIII dissolved the monasteries between 1536 and 1541 and sold them to private buyers. He had broken with Rome, and he wanted their land and their money.',
      'The parish Churches stayed with the Church of England, which still owns them. About 20 close every year. The Church Commissioners, who manage the property of the Church of England, decide whether each one goes on the market.',
      'When a closed Church is sold, two thirds of the money goes to the diocese, the regional body of the Church of England under a bishop. The diocese spends it on the Churches still in use: clergy pay, clergy housing and new Church buildings. The other third goes to the Churches Conservation Trust, the charity that keeps closed Churches of historic value, or pays to maintain other closed Churches while their future is decided.',
      'A Church that was sold years ago and is now being sold on pays its private owner.',
    ],
  },
  {
    name: 'Scotland',
    stamp: '400',
    under: 'kirks to go',
    sells: 'The Church of Scotland, direct',
    money: 'A Church of Scotland fund for repairing the buildings it keeps',
    text: [
      'Scotland is the largest sale of Churches in Europe today. The Church of Scotland still owns its kirks (a kirk is a Scottish Church) and has decided it cannot keep them all.',
      'It plans to part with 350 to 400 buildings, about 30% of what it has.',
      'The money stays with the Church of Scotland. It goes into a building fund held for the local congregation, and is spent on repairing and altering the Churches that stay open.',
    ],
  },
  {
    name: 'Italy',
    stamp: '1866',
    under: 'Confiscation',
    sells: 'Private owners. The State, by public tender',
    money: 'A private seller or the State',
    text: [
      'Napoleon closed the religious orders in 1810, and the new Kingdom of Italy did it again in 1866/7. The State kept more than 800 of the Churches, and the Interior Ministry manages them.',
      'The convents were auctioned from 1867 to pay the debts of the new kingdom. Many are farms and villas now, with the Church still attached. Italy also has many family chapels, built by noble houses on their own land, which pass with the estate.',
      'Most Churches for sale in Italy are sold by a private owner, who keeps the money. When the State sells, the money goes to the State.',
    ],
  },
  {
    name: 'Ireland',
    stamp: '1536',
    under: 'Reformation',
    sells: 'The Church of Ireland, religious orders, private owners',
    money: 'Church of Ireland sales: 80% to the local parish, 20% to a repair fund for other Churches',
    text: [
      'Most old Churches for sale in Ireland belong to the Church of Ireland, the Protestant Church that has held the medieval parish Churches since the Reformation. A central body holds the buildings and sells one when a parish closes.',
      'Of the sale price, 80% stays with the local parish. The other 20% goes to a central fund that pays for repairs to other Church of Ireland buildings.',
      'Catholic Churches belong to the dioceses and almost never come up for sale.',
    ],
  },
  {
    name: 'Portugal',
    stamp: '1834',
    under: 'Orders abolished',
    sells: 'Private owners and companies',
    money: 'The private seller',
    text: [
      'Most Churches in Portugal still belong to the Catholic Church, through its parishes and dioceses.',
      'The monasteries went another way. In 1834 the government abolished the religious orders and took everything they owned. The monasteries and convents were auctioned and became farms and country houses, and their Churches usually passed to the parish.',
    ],
  },
  {
    name: 'Czech Republic',
    stamp: '1948',
    under: 'Communists',
    sells: 'Parishes, and private owners selling on',
    money: 'The parish or the private seller',
    text: [
      'The communist state confiscated the property of the Churches from 25 February 1948. A law of 2012 gave the buildings back. Parishes own their Churches again, and a parish in trouble can sell one.',
    ],
  },
  {
    name: 'Spain',
    stamp: '1836',
    under: 'Mendizábal',
    sells: 'Private owners. Religious orders, with the permission of Rome',
    money: 'The private seller, or the order',
    text: [
      'In 1836 the minister Mendizábal seized the property of the religious orders and put it up for auction. Monasteries, convents and their Churches passed to private buyers, and many are still sold with the farm or the house they became part of.',
      'The parish Churches stayed with the Catholic Church, which keeps them. Between 1998 and 2015 it registered about 35,000 properties in its own name. When a village in Cantabria tried to buy a ruined Church, the Diocese of Bilbao answered that its policy was not to part with any building.',
      'A Church that does come up for sale in Spain is usually in private hands already, and the money goes to that owner. When a religious order sells, the bishop first removes the Church from worship and Rome has to approve the sale.',
    ],
  },
  {
    name: 'Belgium',
    stamp: '1809',
    under: 'Napoleon',
    sells: 'The municipality, or the parish Church council',
    money: 'Whichever of the two owns the building',
    text: [
      'France annexed what is now Belgium in 1795 and took the property of the Church there, as it had at home. In 1809 a decree of Napoleon gave every parish a Church council, the kerkfabriek, to run the building, and made the municipality pay whatever the council could not. That arrangement still stands, so the village pays for a Church whether or not anyone attends.',
      'Flanders has about 1,800 parish Churches, and about 200 no longer hold services. Since 2025 every municipality has had to adopt a plan that says which of its Churches stay in worship and which get a new use. A Church is withdrawn from worship before it is sold.',
      'Each building belongs either to the municipality or to its Church council. In Tongeren-Borgloon, 5 of the 18 Churches marked for a new use belong to the city and the rest to their councils. In Heers the municipality is the seller. The money goes to the owner. The adverts on the shortlist do not say what it is then spent on.',
    ],
  },
];
---

<Base title="Where the money goes" description="How Europe's churches have changed hands over five hundred years, country by country.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="neon">Where the money goes</h1>
    </header>
    <div class="owners">
      <p class="owners-lede">
        For most of their history these buildings belonged to the Church. But over the last 500
        years kings, revolutions and governments have taken them, sold them and occasionally given
        them back. In most of Europe today, the Church no longer owns its old Churches.
      </p>
      <div class="owners-list">
        {countries.map((c, i) => (
          <details class="owner" name="owners">
            <summary>
              <span class="owner-stamp"><b>{c.stamp}</b><i>{c.under}</i></span>
              <span class="owner-name">{c.name}</span>
              <span class="owner-fact"><i>Who sells</i>{c.sells}</span>
              <span class="owner-fact"><i>Where the money goes</i>{c.money}</span>
              <span class="owner-toggle" aria-hidden="true"></span>
            </summary>
            <div class="owner-body">
              {c.text.map((p) => <p>{p}</p>)}
              {count(c.name) > 0 && (
                <a class="button ghost" href="/shortlist/">{count(c.name)} For Sale In {c.name}</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Base>
