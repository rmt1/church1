---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('churches')).filter((c) => !c.data.specimen && c.data.status !== 'saved');
const count = (country: string) => all.filter((c) => c.data.country === country).length;

const countries = [
  {
    name: 'France',
    stamp: '1789',
    under: 'Revolution',
    sells: 'Families and villages',
    money: 'A private seller or the commune',
    text: [
      'France took its Churches from the Church twice. In 1789 the National Assembly seized every religious building in the country to pay off the debts of the State, and auctioned thousands of them to farmers, lawyers and speculators. They have been in private hands ever since.',
      'Then in 1905 the Republic separated Church and State and stopped paying for religion, and the State took the parish Churches too. About 40,000 of them now belong to their village, and the State manages 87 cathedrals.',
      'When a French Church comes up for sale, the seller is usually a family, or a village that can no longer afford it.',
    ],
  },
  {
    name: 'England',
    stamp: '1536',
    under: 'Henry VIII',
    sells: 'The Church Commissioners, or a private owner selling on',
    money: 'Two thirds to the diocese, one third to other closed churches',
    text: [
      'Henry VIII dissolved the monasteries between 1536 and 1541 and sold them to private buyers. He had broken with Rome, and he wanted their land and their money.',
      'The parish Churches stayed with the Church of England, which still owns them. About 20 close every year. The Church Commissioners decide whether each one is sold, handed to a trust or pulled down.',
    ],
  },
  {
    name: 'Scotland',
    stamp: '400',
    under: 'kirks to go',
    sells: 'The Church of Scotland, direct',
    money: 'Back to the Kirk',
    text: [
      'Scotland is the largest sale of Churches in Europe today. The Church of Scotland still owns its kirks (a kirk is a Scottish Church) and has decided it cannot keep them all.',
      'It plans to part with 350 to 400 buildings, about 30% of what it has, and lists them on its own website from £20,000.',
    ],
  },
  {
    name: 'Italy',
    stamp: '1866',
    under: 'Confiscation',
    sells: 'Private owners. The State, by public tender',
    money: 'A private seller or the State',
    text: [
      'Napoleon closed the religious orders in 1810, and the new Kingdom of Italy did it again in 1866 and 1867. The State kept some of the Churches, and the Interior Ministry holds those to this day.',
      'The convents were auctioned from 1867 to pay the debts of the new kingdom. Many of them are farms and villas now, and many still have their Church attached.',
      'Italy also has many family chapels, built by noble houses on their own land. These never belonged to the Church at all and pass with the estate.',
    ],
  },
  {
    name: 'Ireland',
    stamp: '1869',
    under: 'Disestablished',
    sells: 'The Church of Ireland, religious orders, private owners',
    money: 'Church of Ireland sales: 80% for the parish, 20% to a fabric fund',
    text: [
      'The medieval Churches of Ireland went to the Protestant Church of Ireland at the Reformation, in the 1530s. Gladstone disestablished it in 1869, and its Churches passed to a trustee, the Representative Church Body, which sells them when a parish closes.',
      'Catholic Churches belong to the dioceses and almost never come up for sale. Presbyterians own their own, and these are sold when a congregation dies out.',
    ],
  },
  {
    name: 'Portugal',
    stamp: '1834',
    under: 'Orders abolished',
    sells: 'Private owners and companies',
    money: 'The private seller',
    text: [
      'Most Churches in Portugal still belong to the Catholic Church, through its parishes and dioceses.',
      'The monasteries went another way. In 1834 the government abolished the religious orders and took everything they owned. The monasteries and convents were auctioned and became farms and country houses, and their Churches usually passed to the parish.',
    ],
  },
  {
    name: 'Czech Republic',
    stamp: '1948',
    under: 'Communists',
    sells: 'Parishes, and private owners selling on',
    money: 'The parish or the private seller',
    text: [
      'The communist state confiscated the property of the Churches from 25 February 1948. A law of 2012 gave the buildings back. Parishes own their Churches again, and a parish in trouble can sell one.',
    ],
  },
];
---

<Base title="Who owns them" description="How Europe's churches have changed hands over five hundred years, country by country.">
  <div class="wrap">
    <header class="page-head">
      <h1>Who owns them</h1>
    </header>
    <div class="owners">
      <p class="owners-lede">
        For most of their history these buildings belonged to the Church. But over the last 500
        years kings, revolutions and governments have taken them, sold them and occasionally given
        them back. In most of Europe today, the Church no longer owns its old Churches.
      </p>
      <div class="owners-list">
        {countries.map((c, i) => (
          <details class="owner" name="owners" open={i === 0}>
            <summary>
              <span class="owner-stamp"><b>{c.stamp}</b><i>{c.under}</i></span>
              <span class="owner-name">{c.name}</span>
              <span class="owner-fact"><i>Who sells</i>{c.sells}</span>
              <span class="owner-fact"><i>Where the money goes</i>{c.money}</span>
              <span class="owner-toggle" aria-hidden="true"></span>
            </summary>
            <div class="owner-body">
              {c.text.map((p) => <p>{p}</p>)}
              {count(c.name) > 0 && (
                <a class="button ghost" href="/shortlist/">{count(c.name)} For Sale In {c.name}</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Base>
