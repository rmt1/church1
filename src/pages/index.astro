---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import EtchPlate from '../components/EtchPlate.astro';
import { getCollection } from 'astro:content';
import { ageText } from '../lib/age';
import whyRaw from './why.md?raw';
import '@fontsource/libre-caslon-display/400.css';
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/400-italic.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';

const all = (await getCollection('churches')).filter((c) => !c.data.specimen);
const featured = ['basilica-marcay', 'kirkmichael-church', 'chapelle-du-carmel-niort', 'badia-di-montescalari', 'minto-church', 'chapelle-des-chariottes-arras', 'pieve-santo-stefano-monteaguzzo', 'bourtie-kirk', 'chapelle-hanneucourt-gargenville', 'holy-trinity-tunstead', 'santa-maria-del-rivo', 'st-george-south-moor']
  .map((id) => all.find((c) => c.id === id)).filter(Boolean);
const ORDER = ['France', 'England', 'Scotland', 'Italy', 'Ireland', 'Portugal', 'Czech Republic', 'Wales'];
const rank = (c: string) => (ORDER.indexOf(c) + 1) || 99;
const reel = all.filter((c) => c.data.photos[0]).sort((a, b) => rank(a.data.country) - rank(b.data.country) || a.data.difficulty - b.data.difficulty);
// easiest first: the three on show at the start are the three simplest to take on
const byEase = [...reel].sort((a, b) => a.data.difficulty - b.data.difficulty || rank(a.data.country) - rank(b.data.country));
const slots = [0, 1, 2].map((k) => byEase.filter((_, i) => i % 3 === k));
const meta = (d: any) => { const age = ageText(d.built, d.builtNote, d.builtRound); return `${d.country}${age ? `, ${age}` : ''}`; };
// the same lines the ticker carried
const years = all.map((c) => c.data.built).filter((y): y is number => typeof y === 'number');
const oldest = years.length ? new Date().getFullYear() - Math.min(...years) : 0;
const youngest = years.length ? new Date().getFullYear() - Math.max(...years) : 0;
const facts = [`${all.length} churches seeking a keeper`, `${new Set(all.map((c) => c.data.country)).size} countries`, 'From £20,000 to €7,000,000', `The oldest has stood for ${oldest} years`, `The youngest has stood for ${youngest} years`];
// words from Why Save Them, unchanged
const paras = whyRaw.split('---').slice(2).join('---').trim().split(/\n\s*\n/);
const whyLead = paras[0];
const whyQuote = (paras[paras.length - 1].match(/I contend that <em>(.*?)<\/em>/) || [])[1];
---

<Base>
  <div class="intro" id="intro" aria-hidden="true">
    <svg class="door-svg" viewBox="0 0 800 1000" preserveAspectRatio="xMidYMid meet" fill="none" stroke="#111210" stroke-linecap="round" aria-hidden="true">
      <defs>
        <radialGradient id="d-glow" cx="50%" cy="62%" r="62%"><stop offset="0" stop-color="#ffffff" /><stop offset="0.35" stop-color="#f6ff7a" /><stop offset="1" stop-color="#e7ff0a" /></radialGradient>
        <clipPath id="d-arch"><path d="M240 905V430Q240 268 400 150Q560 268 560 430V905z" /></clipPath>
      </defs>
      <g clip-path="url(#d-arch)">
        <rect class="door-light" x="240" y="150" width="320" height="755" fill="url(#d-glow)" stroke="none" />
        <g class="door-leaf door-l"><image href="/intro/door.webp" x="240" y="150" width="160" height="755" preserveAspectRatio="none" /><circle cx="378" cy="640" r="7" fill="#111210" stroke="none" /><circle class="door-ring" cx="378" cy="668" r="19" stroke-width="4.5" /></g>
        <g class="door-leaf door-r"><image href="/intro/door.webp" x="240" y="150" width="160" height="755" preserveAspectRatio="none" transform="translate(800 0) scale(-1 1)" /><circle cx="422" cy="640" r="7" fill="#111210" stroke="none" /><circle class="door-ring" cx="422" cy="668" r="19" stroke-width="4.5" /></g>
      </g>
      <image id="intro-wall" href="/intro/wall.webp" x="-260" y="-90" width="1320" height="1120" />
      <path class="door-gap" d="M400 156V905" stroke="#e7ff0a" stroke-width="3" />
    </svg>
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById('intro');
      var seen = false;
      try { seen = sessionStorage.getItem('entered') === '1'; } catch (e) {}
      if (seen) { el.remove(); return; }
      document.documentElement.classList.add('intro-up');
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var done = false;
      function music() {
        var m = document.getElementById('music'), a = document.getElementById('tune'), off = false;
        try { off = sessionStorage.getItem('tune-on') === '0'; } catch (e) {}
        if (m && a && a.paused && !off) m.click();
      }
      function open() {
        if (done) return; done = true;
        try { sessionStorage.setItem('entered', '1'); } catch (e) {}
        el.classList.add('open');
        setTimeout(function () { document.documentElement.classList.remove('intro-up'); window.dispatchEvent(new Event('intro-done')); }, still ? 0 : 1500);
        setTimeout(function () { el.remove(); }, still ? 400 : 2700);
      }
      // a press on the doors opens them at once; either way the first press anywhere starts the music
      el.addEventListener('click', open);
      function first(e) {
        if (e.target && e.target.closest && e.target.closest('#music')) return;
        music();
      }
      window.addEventListener('pointerdown', first, { once: true, capture: true });
      window.addEventListener('keydown', first, { once: true, capture: true });
      // otherwise the handles knock twice and the doors open by themselves
      var wall = document.getElementById('intro-wall'), started = false;
      function begin() { if (started) return; started = true; el.classList.add('ready'); setTimeout(open, still ? 600 : 2300); }
      var probe = new Image(); probe.onload = probe.onerror = begin; probe.src = '/intro/wall.webp';
      setTimeout(begin, 2500);
    })();
  </script>
  <div class="hb">
    <header class="hb-mast">
      <h1 class="hb-word">Save A Church</h1>
      <Nav />
    </header>

    <section class="hb-hero">
      <p class="hb-note">{facts[0]}</p>
      <h2>A shortlist of old churches for sale across Europe, from £20,000 to €7,000,000.</h2>
      <p>The due diligence is done on each one: the listing read, the heritage rules checked, the repairs priced and the restoration scored from 1 (easy) to 5 (hard).</p>
    </section>

    <div class="hb-noted">
      <p class="hb-note">{facts[1]}</p>
    <div class="hb-show" id="hb-show">
      {featured.map((c: any, i: number) => (
        <a class={`hb-slide${i === 0 ? ' on' : ''}`} href={`/shortlist/${c.id}/`}>
          <img src={i === 0 ? c.data.photos[0].src : undefined} data-src={c.data.photos[0].src} alt={c.data.photos[0].alt} />
          <span class="hb-cap"><span><b>{c.data.name}</b>{c.data.place}, {c.data.region}</span><span>{meta(c.data)}</span></span>
        </a>
      ))}
    </div>
    </div>

    <section class="hb-why">
      <p class="hb-note">{facts[3]}</p>
      <div class="hb-plate"><EtchPlate /></div>
      <div>
        <p class="hb-kicker">The case for preservation</p>
        <p class="hb-lead">{whyLead}</p>
        <a class="hb-more" href="/why/">The case for preservation</a>
      </div>
    </section>

    <section class="hb-list">
      <p class="hb-note">{facts[2]}</p>
      <div class="hb-head"><h2>The Shortlist</h2><a class="hb-more" href="/shortlist/">See all {all.length} churches</a></div>
      {slots.map((group, k) => (
        <div class={`hb-slot${k % 2 ? ' flip' : ''}`} data-slot={k}>
          {group.map((c, i) => (
            <a class={`hb-entry${i === 0 ? ' on' : ''}`} href={`/shortlist/${c.id}/`}>
              <figure><img src={i === 0 ? c.data.photos[0].src : undefined} data-src={c.data.photos[0].src} alt={c.data.photos[0].alt} /></figure>
              <div>
                <p class="hb-meta">{meta(c.data)}</p>
                <h3>{c.data.name}</h3>
                <p class="hb-where">{c.data.place}, {c.data.region}</p>
                <p class="hb-desc">{c.data.summary}</p>
                <dl><dt>{c.data.price}</dt><dd>Difficulty {c.data.difficulty} of 5 <span class="hb-bar">{[1, 2, 3, 4, 5].map((n) => <i class={n <= c.data.difficulty ? 'on' : ''}></i>)}</span></dd></dl>
              </div>
            </a>
          ))}
        </div>
      ))}
      <div class="hb-noted hb-end"><p class="hb-note">{facts[4]}</p>
      <p class="hb-all"><a href="/shortlist/">See all {all.length} churches</a></p></div>
    </section>
  </div>
  <script is:inline>
    (function () {
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function cycle(items, every, delay) {
        if (items.length < 2 || still) return;
        var at = 0;
        function load(el) { var im = el.querySelector('img'); if (im && !im.getAttribute('src')) im.setAttribute('src', im.getAttribute('data-src')); return im; }
        load(items[1]);
        setTimeout(function () {
          setInterval(function () {
            var next = (at + 1) % items.length, im = load(items[next]);
            function go() { items[at].classList.remove('on'); items[next].classList.add('on'); at = next; load(items[(at + 1) % items.length]); }
            if (im && !im.complete) { im.addEventListener('load', go, { once: true }); } else go();
          }, every);
        }, delay);
      }
      cycle([].slice.call(document.querySelectorAll('#hb-show .hb-slide')), 5200, 0);
      [].forEach.call(document.querySelectorAll('.hb-slot'), function (slot, k) { cycle([].slice.call(slot.children), 8000, 1500 + k * 2600); });
    })();
  </script>
</Base>
