---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import Ticker from '../components/Ticker.astro';
import Nav from '../components/Nav.astro';
import Engraving from '../components/Engraving.astro';
import PhotoPlate from '../components/PhotoPlate.astro';
import EtchPlate from '../components/EtchPlate.astro';
import ChurchMap from '../components/ChurchMap.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('churches');
const featured = ['basilica-marcay', 'kirkmichael-church', 'chapelle-du-carmel-niort', 'badia-di-montescalari', 'minto-church', 'chapelle-des-chariottes-arras', 'pieve-santo-stefano-monteaguzzo', 'bourtie-kirk', 'chapelle-hanneucourt-gargenville', 'holy-trinity-tunstead', 'santa-maria-del-rivo', 'st-george-south-moor'].map((id) => all.find((c) => c.id === id)).filter(Boolean);
const ORDER = ['France', 'England', 'Scotland', 'Italy', 'Ireland', 'Portugal', 'Czech Republic', 'Wales'];
const rank = (c: string) => (ORDER.indexOf(c) + 1) || 99;
const reel = all.filter((c) => !c.data.specimen && c.data.photos[0]).sort((a, b) => rank(a.data.country) - rank(b.data.country) || a.data.difficulty - b.data.difficulty);
---

<Base>
  <div class="intro" id="intro" role="dialog" aria-label="Save A Church">
    <div class="intro-door l"></div>
    <div class="intro-door r"></div>
    <div class="intro-in">
      <p class="intro-burst"><b>Be a hero!</b></p>
      <p class="intro-title"><span>Save</span> <span>A</span> <span>Church</span></p>
      <button type="button" class="intro-enter" id="intro-enter">Enter here</button>
      <p class="intro-note"><span aria-hidden="true">&#9834;</span> With music</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById('intro');
      var seen = false;
      try { seen = sessionStorage.getItem('entered') === '1'; } catch (e) {}
      if (seen) { el.remove(); return; }
      document.documentElement.classList.add('intro-up');
      var done = false;
      function enter() {
        if (done) return; done = true;
        try { sessionStorage.setItem('entered', '1'); } catch (e) {}
        var m = document.getElementById('music'), a = document.getElementById('tune');
        if (m && a && a.paused) m.click();
        el.classList.add('open');
        document.documentElement.classList.remove('intro-up');
        window.dispatchEvent(new Event('intro-done'));
        setTimeout(function () { el.remove(); }, 1500);
      }
      document.getElementById('intro-enter').addEventListener('click', enter);
      el.addEventListener('keydown', function (e) { if (e.key === 'Escape') enter(); });
    })();
  </script>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 class="glow">Save A Church</h1>
        <Nav />
        <div class="hero-reel">
          <ul class="hero-strip">
            {[...reel, ...reel].map((c, i) => (
              <li aria-hidden={i >= reel.length ? 'true' : undefined}>
                <a href={`/shortlist/${c.id}/`} tabindex={i >= reel.length ? -1 : undefined}>
                  <img src={c.data.photos[0].src.replace(/\/(\d+)\.jpg$/, '/t/$1.webp')} alt={c.data.photos[0].alt} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
                  <span>{c.data.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="shrine"><EtchPlate /></div>
    </div>
  </section>

  <Ticker />

  <section class="section atlas-section">
    <div class="wrap"><ChurchMap /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="tiles">
        {featured.map((c) => <li><Tile church={c} /></li>)}
      </ul>
      <p class="see-all"><a class="button ghost" href="/shortlist/">See all {all.length} churches</a></p>
    </div>
  </section>
</Base>
