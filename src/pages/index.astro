---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('churches');
const featured = ['chapel-near-sancerre', 'temple-crevecoeur-le-grand', 'chapelle-des-chariottes-arras'].map((id) => all.find((c) => c.id === id)).filter(Boolean);
---

<Base>
  <section class="hero has-photo" style="--hero: url(/photos/chapelle-des-chariottes-arras/1.jpg)">
    <div class="wrap">
      <h1>Adopt a church.</h1>
      <p>
        Old churches are for sale all over Europe, and most of them cost less than a parking space in
        San Francisco. Somebody has to pay for the gutters. I think more people should.
      </p>
      <div class="actions">
        <a class="button on-dark" href="/shortlist/">See the shortlist</a>
        <a class="button on-dark ghost" href="/why/">Read the argument</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Churches you could buy</h2>
        <a href="/shortlist/">View all</a>
      </div>
      <ul class="tiles">
        {featured.map((c) => <li><Tile church={c} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap pull">
      <p>
        You buy the building, you fix the roof, you keep the door open, and when you die it is still
        standing. I call this heritage custodianship.
      </p>
      <a class="button ghost" href="/why/">Why save them</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap thirds">
      <div>
        <h3>The due diligence, done</h3>
        <p>
          We read the listings, check the heritage status, and write down what is wrong with each
          building and what it will cost to put right.
        </p>
        <a href="/before-you-buy/">Before you buy</a>
      </div>
      <div>
        <h3>Who is selling</h3>
        <p>
          In France the Church has not owned its old parish churches since 1905. Every profile names
          the seller and says where the money goes.
        </p>
        <a href="/who-owns-the-churches/">Who owns the churches</a>
      </div>
      <div>
        <h3>No spare chapel money?</h3>
        <p>
          Give to the people who rescue the churches nobody else will take. Membership costs less
          than dinner.
        </p>
        <a href="/donate/">Support the rescuers</a>
      </div>
    </div>
  </section>
</Base>
