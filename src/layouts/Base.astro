---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import '@fontsource/grenze/latin-400.css';
import '@fontsource/grenze/latin-400-italic.css';
import '@fontsource/grenze/latin-600.css';
import '@fontsource/grenze-gotisch/latin-500.css';
import '@fontsource/grenze-gotisch/latin-700.css';
import '@fontsource/bangers/latin-400.css';
import '@fontsource/pirata-one/latin-400.css';
import Ticker from '../components/Ticker.astro';
import Signup from '../components/Signup.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Save A Church';
// Page views come from GoatCounter. Put the site code here (the part before .goatcounter.com) to switch the counter on.
const goatcounter = 'saveachurch';
const { title, description = 'A shortlist of old churches a private person could buy and keep standing, with the due diligence done.' } = Astro.props;
const path = Astro.url.pathname;

const churches = (await getCollection('churches')).filter((c) => !c.data.specimen && c.data.status !== 'saved');
const count = churches.length;
const countries = new Set(churches.map((c) => c.data.country)).size;
const years = churches.map((c) => c.data.built).filter(Boolean) as number[];
const oldest = years.length ? new Date().getFullYear() - Math.min(...years) : 0;
const digits = String(count).padStart(6, '0').split('');
const news = [
  `${count} churches seeking a keeper`,
  `${countries} countries`,
  oldest ? `The oldest has stood for ${oldest} years` : '',
  'Best viewed by candlelight',
].filter(Boolean);

const nav = [
  { href: '/shortlist/', label: 'The shortlist' },
  { href: '/who-owns-the-churches/', label: 'Where the money goes' },
  { href: '/why/', label: 'Why save them' },
  { href: '/donate/', label: 'Donate' },
];
---

<!doctype html>
<html lang="en" style="--stone: url(/bg/stone.webp)">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | ${site}` : site}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title ? `${title} | ${site}` : site} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://saveachurch.org').href} />
    <meta property="og:image" content="https://saveachurch.org/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://saveachurch.org/og.jpg" />
  </head>
  <body>
    <div class="sheet">
    {path !== '/' && (
      <>
        <header class="site-head">
          <div class="wrap">
            <a class="site-name" href="/"><svg class="crest" viewBox="0 0 40 46" aria-hidden="true"><path d="M2 2h36v22c0 11-8 17-18 20C10 41 2 35 2 24z" fill="#d0122d" stroke="#23170f" stroke-width="2.5"/><path d="M2 2h36v8H2z" fill="#f2c21a" stroke="#23170f" stroke-width="2.5"/><path d="M13 34V22l7-7 7 7v12z" fill="#fff6dc" stroke="#23170f" stroke-width="2"/><path d="M20 6v7M17 9h6" stroke="#23170f" stroke-width="2"/><path d="M18 34v-6a2 2 0 0 1 4 0v6z" fill="#1c3fa8" stroke="#23170f" stroke-width="1.5"/></svg>{site}</a>
            <Nav />
          </div>
        </header>
      </>
    )}
    <div class="bunting" aria-hidden="true"></div>

    <main>
      <slot />
    </main>

    <Signup />

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <a class="site-name" href="/">{site}</a>
        </div>
        <div class="foot-fun">
          <p class="badges" aria-hidden="true">
            <span>Anno Domini {new Date().getFullYear()}</span>
          </p>
        </div>
      </div>
    </footer>
    </div>
    <button type="button" class="music" id="music" aria-pressed="false">
      <span class="music-note" aria-hidden="true">&#9834;</span><span class="music-label">Summon the minstrel</span>
    </button>
    <audio id="tune" src="/music/vivaldi-summer-presto.mp3" loop preload="none"></audio>
    <script is:inline>
      (function () {
        var b = document.getElementById('music'), a = document.getElementById('tune');
        if (!b || !a) return;
        var label = b.querySelector('.music-label');
        var get = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
        var set = function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} };
        function show(on) { b.setAttribute('aria-pressed', String(on)); label.textContent = on ? 'Silence, minstrel!' : 'Summon the minstrel'; }
        function start() {
          var t = parseFloat(get('tune-at') || '0');
          var go = function () { if (t && isFinite(t)) { try { a.currentTime = t; } catch (e) {} } };
          a.addEventListener('loadedmetadata', go, { once: true });
          a.volume = 0.5;
          return a.play().then(function () { show(true); set('tune-on', '1'); }).catch(function () { show(false); });
        }
        b.addEventListener('click', function () {
          if (a.paused) start(); else { a.pause(); show(false); set('tune-on', '0'); }
        });
        window.addEventListener('pagehide', function () { if (!a.paused) set('tune-at', String(a.currentTime)); });
        if (get('tune-on') === '1') start();
      })();
    </script>
    {goatcounter && <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
    <script is:inline>
      (function () {
        var el = document.getElementById('views');
        var code = el && el.dataset.gc;
        if (!code) return;
        fetch('https://' + code + '.goatcounter.com/counter/TOTAL.json')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var n = String(d.count || '').replace(/\D/g, '');
            if (!n) return;
            el.querySelector('.odometer').innerHTML = n.padStart(6, '0').split('').map(function (c) { return '<b>' + c + '</b>'; }).join('');
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
