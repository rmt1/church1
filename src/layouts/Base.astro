---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Adopt a Church';
const { title, description = 'A shortlist of old churches a private person could buy and keep standing, with the due diligence done.' } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/shortlist/', label: 'The shortlist' },
  { href: '/why/', label: 'Why save them' },
  { href: '/who-owns-the-churches/', label: 'Who owns them' },
  { href: '/before-you-buy/', label: 'Before you buy' },
  { href: '/donate/', label: "Can't buy one?" },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site}` : site}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+Double+Pica:ital@0;1&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- the pointed-arch shape every church picture sits in -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <clipPath id="lancet" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.44 C0,0.24 0.26,0.1 0.5,0 C0.74,0.1 1,0.24 1,0.44 L1,1 Z"></path>
      </clipPath>
    </svg>

    <header class="site-head">
      <a class="site-name" href="/">{site}</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <p>
        We publish; we do not broker. Every church links to the agent or owner selling it, and we take
        no commission. Costs on this site are estimates. Commission a survey before you make an offer.
      </p>
    </footer>
  </body>
</html>
