---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Adopt a Church';
const { title, description = 'A shortlist of old churches a private person could buy and keep standing, with the due diligence done.' } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/shortlist/', label: 'The shortlist' },
  { href: '/why/', label: 'Why save them' },
  { href: '/who-owns-the-churches/', label: 'Who owns them' },
  { href: '/before-you-buy/', label: 'Before you buy' },
  { href: '/donate/', label: 'Donate' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site}` : site}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="site-name" href="/">{site}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <a class="site-name" href="/">{site}</a>
          <p>
            We publish; we do not broker. Every church links to the agent or owner selling it, and we
            take no commission. Costs on this site are estimates. Commission a survey before you make
            an offer.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
