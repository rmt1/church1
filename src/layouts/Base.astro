---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const site = "A Church of One's Own";
const { title, description = 'A shortlist of old churches a private person could buy and keep standing, with the due diligence done.' } = Astro.props;
const path = Astro.url.pathname;

const churches = (await getCollection('churches')).filter((c) => !c.data.specimen && c.data.status !== 'saved');
const count = churches.length;
const countries = new Set(churches.map((c) => c.data.country)).size;
const years = churches.map((c) => c.data.built).filter(Boolean) as number[];
const oldest = years.length ? new Date().getFullYear() - Math.min(...years) : 0;
const digits = String(count).padStart(6, '0').split('');
const news = [
  `${count} churches seeking a keeper`,
  `${countries} countries`,
  oldest ? `The oldest has stood for ${oldest} years` : '',
  'No commission taken',
  'Bring your own gutters',
  'Best viewed by candlelight',
].filter(Boolean);

const nav = [
  { href: '/shortlist/', label: 'The shortlist' },
  { href: '/why/', label: 'Why save them' },
  { href: '/who-owns-the-churches/', label: 'Who owns them' },
  { href: '/before-you-buy/', label: 'Before you buy' },
  { href: '/donate/', label: 'Donate' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site}` : site}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Pirata+One&family=Uncial+Antiqua&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="site-name" href="/">{site}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-run">
        {[0, 1].map(() => news.map((n) => <span>{n}</span>))}
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <a class="site-name" href="/">{site}</a>
          <p>
            We publish; we do not broker. Every church links to the agent or owner selling it, and we
            take no commission. Costs on this site are estimates. Commission a survey before you make
            an offer.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div class="foot-fun">
          <p class="counter" aria-label={`${count} churches on the shortlist`}>
            <span class="counter-label">Churches on the shortlist</span>
            <span class="odometer" aria-hidden="true">{digits.map((n) => <b>{n}</b>)}</span>
          </p>
          <p class="badges" aria-hidden="true">
            <span>Best viewed by candlelight</span>
            <span>Written with a quill</span>
            <span>Anno Domini {new Date().getFullYear()}</span>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
