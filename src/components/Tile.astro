---
const { church } = Astro.props;
const d = church.data;
---

<a class="tile" href={`/shortlist/${church.id}/`}>
  <div class="frame">
    {d.photos[0] ? (
      <img src={d.photos[0].src} alt={d.photos[0].alt} loading="lazy" style={d.photos[0].focus ? `object-position: ${d.photos[0].focus}` : undefined} />
    ) : (
      <span class="numeral" aria-hidden="true">{d.century ?? ''}</span>
    )}
    {d.specimen && <span class="flag">Specimen</span>}
    {d.status === 'saved' && <span class="flag saved">Saved</span>}
    {d.status === 'under offer' && <span class="flag">Under offer</span>}
  </div>
  <p class="meta">{d.country}{d.century ? `, ${d.century} century` : ''}</p>
  <h3>{d.name}</h3>
  <p class="where">{d.place}, {d.region}</p>
  <p class="price">{d.price}</p>
  <p class="sub">{d.heritageClass} / {d.verdict} / Difficulty {d.difficulty} of 5</p>
</a>
