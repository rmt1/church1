---
import { ageText } from '../lib/age';
const { church } = Astro.props;
const d = church.data;
const age = ageText(d.built, d.builtNote, d.builtRound);
---

<a class="tile" href={`/shortlist/${church.id}/`}>
  <div class="frame" style={d.photos[0] ? `--img: url(${d.photos[0].src})` : undefined}>
    {d.photos[0] ? (
      <img src={d.photos[0].src} alt={d.photos[0].alt} loading="lazy" />
    ) : (
      <span class="numeral" aria-hidden="true"></span>
    )}
    {d.specimen && <span class="flag">Specimen</span>}
    {d.status === 'saved' && <span class="flag saved">Saved</span>}
    {d.status === 'under offer' && <span class="flag">Under offer</span>}
  </div>
  <p class="meta">{d.country}{age ? `, ${age}` : ''}</p>
  <h3>{d.name}</h3>
  <p class="where">{d.place}, {d.region}</p>
  <p class="price">{d.price}</p>
  <p class="sub">Difficulty {d.difficulty} of 5</p>
</a>
