---
// Email sign-up. Stays hidden until `action` is set to the mailing-list provider's form address.
const action = import.meta.env.PUBLIC_SIGNUP_ACTION ?? '';
const field = import.meta.env.PUBLIC_SIGNUP_FIELD ?? 'email';
---
{action && (
  <section class="signup" aria-labelledby="signup-h">
    <div class="wrap">
      <h2 id="signup-h" class="neon">Hear when a church is added</h2>
      <p>One email each time a church joins the shortlist. Nothing else.</p>
      <form action={action} method="post" target="_blank">
        <label class="sr-only" for="signup-email">Your email address</label>
        <input id="signup-email" type="email" name={field} placeholder="you@example.com" autocomplete="email" required />
        <button class="button pop" type="submit">Sign me up</button>
      </form>
    </div>
  </section>
)}
