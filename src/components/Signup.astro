---
// Email sign-up, sent to the Buttondown list "saveachurch".
const action = import.meta.env.PUBLIC_SIGNUP_ACTION ?? 'https://buttondown.com/api/emails/embed-subscribe/saveachurch';
const field = import.meta.env.PUBLIC_SIGNUP_FIELD ?? 'email';
---
{action && (
  <section class="signup" aria-labelledby="signup-h">
    <div class="wrap">
      <h2 id="signup-h" class="neon">Subscribe for the occasional update</h2>
      <form action={action} method="post" target="_blank">
        <label class="sr-only" for="signup-email">Your email address</label>
        <input id="signup-email" type="email" name={field} placeholder="you@example.com" autocomplete="email" required />
        <input type="hidden" value="1" name="embed" />
        <button class="button pop" type="submit">Stay updated</button>
      </form>
    </div>
  </section>
)}
